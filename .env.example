# The bot reads plain environment variables. Copy these into your shell, IDE run config, or Docker env.
DISCORD_TOKEN=your-bot-token

# Defaults for every Discord server. Each server's admins can override these with /settings.

# Default Albion Data Project server: west (Americas), east (Asia), europe
ALBION_SERVER=east

# Optional, for testing: comma-separated server IDs to register commands in directly (instant).
# Leave empty in production: commands are then registered globally and work in every server the bot joins.
DEV_GUILD_ID=

# Ignore market rows older than this many hours
MAX_DATA_AGE_HOURS=24

# true = premium account (4% market tax), false = 8%
PREMIUM=true

# Silver per 100 nutrition shown on the crafting station you use. Check in game; 500 is a placeholder.
STATION_FEE=500

# Where build output lives
RECIPES_PATH=data/recipes.json

# Per-server settings saved by /settings
GUILDS_PATH=data/guilds.json

# Albion guild links and member registrations saved by /guild and /register
ACCESS_PATH=data/access.json

# Personal premium/station fee settings saved by /mysettings
USERS_PATH=data/users.json
